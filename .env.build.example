# Copy this file to .env.build before running the desktop app or creating installers.
# .env.build is ignored by git because it contains deployment credentials.
# The same file is loaded by bun run dev, bun run dev:tauri and all Tauri build scripts.

AUTOCNA_TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
AUTOCNA_TURSO_AUTH_TOKEN=replace-with-your-rotated-turso-token
